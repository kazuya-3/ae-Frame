node_modules/
dist/
*.local
.DS_Store
*.tsbuildinfo
.vite/
tests/fixtures/
tests/real/
dist-demo/

# tsc がまちがって src に吐いた成果物。
# これが残っていると、Vite が .tsx ではなく古い .js のほうを読んでしまい、
# 直したはずの画面が直っていない、という追いにくい状態になる。
src/**/*.js
src/**/*.js.map
src/**/*.d.ts

# ただし vite-env.d.ts は手で書いた**元のファイル**で、tsc の吐きものではない。
# 上の行に巻きこまれて外れると、virtual:tip の宣言が公開のビルドに無く、
# tsc -b がそこで止まる（手もとだけ通って CI で落ちる、いちばん分かりにくい形）。
!src/vite-env.d.ts

# お礼の入口あり・なしのビルド。検証が毎回作り直すので、置いておく意味は無い
dist-tip/
dist-notip/
